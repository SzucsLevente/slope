+      their own title bar: GTK headerbars, libadwaita, Electron, Chrome...)
+    */
+    gboolean force_decor;
+    /*! Slope: _NET_WM_WINDOW_TYPE only had types Openbox does not know
+      (notification, tooltip, popup menu...), never force a frame on those */
+    gboolean odd_type;
