# Boot menu settings for an installed Slope system (run update-grub after editing)
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="Slope"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 splash"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=false
GRUB_BACKGROUND="/usr/share/backgrounds/slope/grub.png"
GRUB_GFXMODE=auto
# Start Linux in text mode, like the live USB: keeping GRUB's graphics mode
# gives the kernel a temporary framebuffer that the real GPU driver replaces
# a moment later, which left a black screen on VirtualBox.
GRUB_GFXPAYLOAD_LINUX=text
