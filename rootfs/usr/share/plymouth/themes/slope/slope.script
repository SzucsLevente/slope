# Slope boot splash: glossy logo over a deep blue gradient with pulsing dots.
Window.SetBackgroundTopColor(0.02, 0.06, 0.23);
Window.SetBackgroundBottomColor(0.12, 0.30, 0.78);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 1);

dot.image = Image("dot.png");
for (i = 0; i < 5; i++) {
  dots[i] = Sprite(dot.image);
  dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 - 52 + i * 22,
                      logo.y + logo.image.GetHeight() + 48, 2);
  dots[i].SetOpacity(0.2);
}

tick = 0;
fun refresh_callback() {
  tick++;
  for (i = 0; i < 5; i++) {
    dots[i].SetOpacity(0.2 + 0.8 * (Math.Sin(tick * 0.09 - i * 0.7) + 1) / 2);
  }
  logo.sprite.SetOpacity(Math.Min(1, tick / 40));
}
Plymouth.SetRefreshFunction(refresh_callback);

# password prompt (encrypted disks)
fun display_password_callback(prompt, bullets) {
  global.pw_label = Sprite(Image.Text(prompt + "  " + bullets, 1, 1, 1));
  global.pw_label.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.pw_label.GetImage().GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 90, 3);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun display_normal_callback() { global.pw_label = NULL; }
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  global.msg = Sprite(Image.Text(text, 0.9, 0.95, 1));
  global.msg.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.msg.GetImage().GetWidth() / 2,
                         Window.GetY() + Window.GetHeight() - 60, 3);
}
Plymouth.SetMessageFunction(message_callback);
