<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <!-- title-bar right-click menu.  Openbox's built-in client-menu would
       really close the window; this one's Close keeps the app running. -->
  <menu id="slope-window-menu" label="Window">
    <item label="Minimize"><action name="Iconify"/></item>
    <item label="Zoom"><action name="ToggleMaximize"/></item>
    <item label="Full Screen"><action name="ToggleFullscreen"/></item>
    <item label="Keep on Top"><action name="ToggleAlwaysOnTop"/></item>
    <separator/>
    <item label="Move"><action name="Move"/></item>
    <item label="Resize"><action name="Resize"/></item>
    <separator/>
    <item label="Hide App"><action name="Execute"><command>slope-ctl hide-app</command></action></item>
    <item label="Close Window"><action name="Execute"><command>slope-ctl close-window</command></action></item>
    <item label="Quit App"><action name="Execute"><command>slope-ctl quit-app</command></action></item>
  </menu>
  <menu id="root-menu" label="Slope">
    <item label="Terminal"><action name="Execute"><command>xfce4-terminal</command></action></item>
    <item label="Files"><action name="Execute"><command>thunar</command></action></item>
    <separator/>
    <item label="System Settings"><action name="Execute"><command>slope-settings</command></action></item>
    <item label="Restart Window Manager"><action name="Restart"/></item>
  </menu>
</openbox_menu>
