#!/bin/sh
# Started by Openbox once the window manager is up.
mkdir -p "$HOME/.cache" "$HOME/.config/slope"
slope-ctl picom-config >/dev/null 2>&1   # windows minimize towards the Dock
/usr/lib/slope/slope-compositor &

# trackpad / mouse settings (scroll direction, tap to click...) and gestures
slope-ctl input >/dev/null 2>&1
# keyboard layouts (System Settings > Keyboard), displays and brightness
slope-ctl keyboard >/dev/null 2>&1
slope-ctl display >/dev/null 2>&1
( while xprop -root >/dev/null 2>&1; do /usr/lib/slope/slope-gestures; sleep 2; done ) &

# asks for your password when an app needs administrator rights (App Store...)
for agent in /usr/libexec/polkit-mate-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1; do
  [ -x "$agent" ] && { "$agent" & break; }
done

# The shell (desktop, top bar, dock).  Restarted automatically if it ever crashes.
(
  while xprop -root >/dev/null 2>&1; do
    slope-shell >>"$HOME/.cache/slope-shell.log" 2>&1
    sleep 1
  done
) &

# Welcome window on the very first login
if grep -q "boot=casper" /proc/cmdline 2>/dev/null; then
  # live USB/DVD: offer to install
  (sleep 4; slope-settings --welcome) &
elif [ ! -e "$HOME/.config/slope/welcomed" ]; then
  mkdir -p "$HOME/.config/slope" && touch "$HOME/.config/slope/welcomed"
  (sleep 4; slope-settings --about) &
fi
