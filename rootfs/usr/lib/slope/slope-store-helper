#!/usr/bin/python3 -I
"""Slope Store's privileged helper.  Runs as root through pkexec.

    slope-store-helper refresh            apt-get update
    slope-store-helper install PKG...     apt-get install
    slope-store-helper remove PKG...      apt-get remove (never Slope's own packages)
    slope-store-helper upgrade            install all updates
    slope-store-helper install-deb FILE   install a downloaded .deb with its dependencies

Progress goes to stdout as one JSON object per line:
    {"type": "progress", "percent": 42.0, "text": "Unpacking gimp"}
    {"type": "done"}   or   {"type": "error", "text": "..."}

Polkit: refresh needs no password (org.slope.store.refresh, through the
slope-store-refresh wrapper); everything else asks for an administrator
password (org.slope.store.install).
"""
import json
import os
import re
import subprocess
import sys

CORE = "/usr/share/slope/core-packages.txt"
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9+.-]{0,99}(:[a-z0-9]+)?$")
ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C.UTF-8",
           PATH="/usr/sbin:/usr/bin:/sbin:/bin")
APT = ["apt-get", "-y", "-q", "-o", "Dpkg::Options::=--force-confdef",
       "-o", "Dpkg::Options::=--force-confold",
       # another apt (the daily background update, the App Store...) may be
       # busy: wait for it instead of failing
       "-o", "DPkg::Lock::Timeout=300"]


def say(**msg):
    print(json.dumps(msg), flush=True)


def core_packages():
    keep = set()
    try:
        with open(CORE) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if line:
                    keep.add(line)
    except OSError:
        pass
    return keep


def friendly(kind, text):
    """apt's status text, in plain words."""
    m = re.match(r"(Unpacking|Installing|Configuring|Removing|Preparing to configure|Preparing) (\S+)", text)
    if m:
        verb = {"Unpacking": "Installing", "Preparing": "Preparing", "Preparing to configure":
                "Setting up", "Configuring": "Setting up", "Installing": "Installing",
                "Removing": "Removing"}[m.group(1)]
        return "%s %s" % (verb, m.group(2).split(":")[0])
    m = re.match(r"Retrieving file (\d+) of (\d+)", text)
    if m:
        return "Downloading (%s of %s)" % m.groups()
    if text.startswith("Running post-installation trigger"):
        return "Finishing"
    if text == "Running dpkg":
        return "Installing"
    return text


LAST_OUTPUT = [""]


def dpkg_status(pkg):
    r = subprocess.run(["dpkg-query", "-W", "-f", "${Status}", pkg], env=ENV, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and "not-installed" not in r.stdout else ""


def run_apt(args, weight=(0, 100), download_share=1 / 3.0, report=True):
    """Run apt-get, turning its status lines into progress messages.
    download_share: part of the bar used by downloading (apt-get update: all)."""
    r, w = os.pipe()
    # apt writes its machine-readable progress to this pipe (the pipe's own
    # descriptor number: Popen closes every other descriptor in the child)
    proc = subprocess.Popen(APT + ["-o", "APT::Status-Fd=%d" % w] + args, env=ENV, pass_fds=(w,),
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    os.close(w)
    lo, hi = weight
    with os.fdopen(r) as status:
        import threading
        out = []

        def drain():
            for line in proc.stdout:
                out.append(line)
        t = threading.Thread(target=drain, daemon=True)
        t.start()
        for line in status:
            parts = line.rstrip("\n").split(":", 3)
            if len(parts) == 4 and parts[0] in ("dlstatus", "pmstatus"):
                try:
                    pct = float(parts[2])
                except ValueError:
                    continue
                if parts[0] == "dlstatus":      # downloading first...
                    pct = pct * download_share
                else:                           # ...then installing
                    pct = download_share * 100 + pct * (1 - download_share)
                say(type="progress", percent=round(lo + (hi - lo) * pct / 100.0, 1),
                    text=friendly(parts[0], parts[3]))
        proc.wait()
        t.join(2)
    LAST_OUTPUT[0] = "".join(out)
    if proc.returncode != 0:
        if report:
            say(type="error", text=explain("".join(out)) or "apt-get failed (%d)" % proc.returncode,
                details="".join(out[-60:]).strip())
        return False
    return True


def explain(output):
    """apt's failure, in plain words (the details go along separately)."""
    unmet = re.findall(r"Depends: (\S+)[^\n]*but (?:it is not installable|it is not going to be installed|"
                       r"[^\n]* is to be installed)", output)
    if "dpkg was interrupted" in output:
        return "An earlier installation was interrupted. Slope repaired it: please try again."
    if "Could not get lock" in output or "Unable to acquire the dpkg frontend lock" in output:
        return "Another program is installing software right now. Try again in a minute."
    if unmet:
        names = ", ".join(sorted(set(unmet))[:8])
        return ("This package needs software that is not available for this version of Ubuntu "
                "(%s). It may be made for a different Linux version." % names)
    if "Errors were encountered while processing" in output:
        return "The package's own setup script failed."
    lines = [l for l in output.splitlines() if l.startswith("E:")]
    return lines[-1][2:].strip() if lines else ""


def repair():
    """Finish an interrupted or half-done installation (dpkg --configure -a,
    apt-get --fix-broken install), so one failure doesn't block every later one."""
    audit = subprocess.run(["dpkg", "--audit"], env=ENV, capture_output=True, text=True)
    if audit.stdout.strip():
        say(type="progress", percent=1, text="Finishing an earlier installation")
        subprocess.run(["dpkg", "--configure", "-a", "--force-confdef", "--force-confold"],
                       env=ENV, capture_output=True)
        subprocess.run(APT + ["--fix-broken", "install"], env=ENV, capture_output=True)


def installed(pkg):
    r = subprocess.run(["dpkg-query", "-W", "-f", "${Status}", pkg], env=ENV, capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() == "install ok installed"


REFRESHED = "/var/lib/slope/apt-refreshed"     # touched after every good refresh


def lists_fresh(max_age=3600):
    """Package lists refreshed by us within max_age seconds (apt gives its
    list files the server's dates, so their own times can't tell)."""
    import time
    try:
        return lists_present() and time.time() - os.path.getmtime(REFRESHED) < max_age
    except OSError:
        return False


def lists_present():
    d = "/var/lib/apt/lists"
    try:
        return any(n.endswith("_Packages") or n.endswith("_Packages.lz4") for n in os.listdir(d))
    except OSError:
        return False


def refresh(weight=(0, 100)):
    say(type="progress", percent=weight[0], text="Checking for new software")
    if not run_apt(["update"], weight, download_share=1.0):
        return False
    try:
        os.makedirs(os.path.dirname(REFRESHED), exist_ok=True)
        with open(REFRESHED, "w"):
            pass
    except OSError:
        pass
    say(type="progress", percent=weight[1], text="Software list updated")
    return True


def check_names(pkgs):
    bad = [p for p in pkgs if not PKG_RE.match(p)]
    if bad or not pkgs:
        say(type="error", text="Not a package name: %s" % " ".join(bad or ["(none)"]))
        return False
    return True


DEB_CACHE = "/var/cache/slope-deb"


def install_deb(path):
    """Install a .deb file the user opened, with the dependencies it needs."""
    import shutil
    import tempfile
    if not (os.path.isabs(path) and path.endswith(".deb") and os.path.isfile(path)):
        say(type="error", text="Not a .deb package: %s" % path)
        return False
    # work on root's own copy (the user's file could change underneath us)
    os.makedirs(DEB_CACHE, mode=0o755, exist_ok=True)
    tmpdir = tempfile.mkdtemp(dir=DEB_CACHE)
    os.chmod(tmpdir, 0o755)
    copy = os.path.join(tmpdir, "package.deb")
    try:
        shutil.copyfile(path, copy)
        os.chmod(copy, 0o644)
        info = subprocess.run(["dpkg-deb", "-f", copy, "Package"], env=ENV, capture_output=True, text=True)
        if info.returncode != 0 or not info.stdout.strip():
            say(type="error", text="This file is not a valid .deb package.")
            return False
        name = info.stdout.strip()
        say(type="progress", percent=1, text="Preparing to install %s" % name)
        repair()
        # dependencies come from the Ubuntu archive: get its latest list
        # (an old or missing list is the usual reason a .deb fails)
        if not lists_fresh():
            if not refresh((2, 20)):
                return False
        weight = (20, 100)
        say(type="progress", percent=20, text="Checking what %s needs" % name)
        # never let a package push out parts of Slope itself
        sim = subprocess.run(["apt-get", "-s", "install", copy], env=ENV, capture_output=True, text=True)
        removing = re.findall(r"^Remv (\S+)", sim.stdout, re.M)
        hit = sorted(p for p in removing if p.split(":")[0] in core_packages())
        if hit:
            say(type="error", text="Installing this would remove parts of Slope itself (%s), "
                                   "so it was not installed." % ", ".join(hit[:6]))
            return False
        if sim.returncode != 0 and "unmet dependencies" in (sim.stdout + sim.stderr):
            say(type="error", text=explain(sim.stdout + sim.stderr), details=(sim.stdout + sim.stderr)[-4000:])
            return False
        if run_apt(["install", copy], weight, report=False):
            return True
        # its setup failed: let dpkg retry once, and if the package still
        # isn't working, take it out again, so a broken package never blocks
        # every later installation
        repair()
        if installed(name):
            return True
        if dpkg_status(name):
            subprocess.run(["dpkg", "--remove", "--force-remove-reinstreq", name], env=ENV, capture_output=True)
            subprocess.run(APT + ["--fix-broken", "install"], env=ENV, capture_output=True)
        out = LAST_OUTPUT[0]
        msg = explain(out) or "The package could not be installed."
        if "setup script" in msg:
            msg = "The package's own setup script failed, so it was removed again."
        say(type="error", text=msg, details=out[-4000:].strip())
        return False
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def main(argv):
    if os.geteuid() != 0:
        say(type="error", text="slope-store-helper must run as root (through pkexec)")
        return 1
    if not argv:
        say(type="error", text=__doc__)
        return 2
    cmd, pkgs = argv[0], argv[1:]
    ok = False
    if cmd == "refresh":
        ok = refresh()
    elif cmd == "install":
        if check_names(pkgs):
            ok = True
            if not lists_present():
                ok = refresh((0, 10))
            ok = ok and run_apt(["install", "--no-install-recommends"] + pkgs,
                                (10, 100) if not lists_present() else (0, 100))
    elif cmd == "remove":
        if check_names(pkgs):
            sim = subprocess.run(["apt-get", "-s", "remove"] + pkgs, env=ENV,
                                 capture_output=True, text=True)
            removing = re.findall(r"^Remv (\S+)", sim.stdout, re.M)
            core = core_packages()
            hit = sorted(p for p in removing if p.split(":")[0] in core)
            if sim.returncode != 0:
                say(type="error", text=(sim.stdout + sim.stderr).strip()[-800:])
            elif hit:
                say(type="error", text="Removing this would also remove parts of Slope itself (%s), "
                                       "so it was not removed." % ", ".join(hit[:6]))
            else:
                ok = run_apt(["remove"] + pkgs)
    elif cmd == "install-deb":
        ok = len(pkgs) == 1 and install_deb(pkgs[0])
        if len(pkgs) != 1:
            say(type="error", text="install-deb takes one file")
    elif cmd == "upgrade":
        ok = refresh((0, 10)) and run_apt(["--with-new-pkgs", "upgrade"], (10, 100))
    else:
        say(type="error", text="unknown command: %s" % cmd)
        return 2
    if ok:
        say(type="done")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
