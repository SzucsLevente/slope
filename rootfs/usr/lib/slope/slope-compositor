#!/bin/sh
# Run picom for the whole session, and start it again if it ever stops
# (without a compositor the Dock and menus would get black backgrounds).
#
# Real GPUs get the GLX backend with frosted-glass blur.  Software rendering
# and virtual machines (VirtualBox / VMware "SVGA3D", llvmpipe), whose OpenGL
# is often unreliable with transparent windows, get the XRender backend.
# If GLX keeps failing, we switch to XRender for the rest of the session.
#
# Moving the Dock writes a new ~/.config/slope/picom.conf and stops picom;
# this loop starts it again with the new config.
mkdir -p "$HOME/.cache"
LOG="$HOME/.cache/slope-picom.log"

RENDERER=$(glxinfo -B 2>/dev/null | grep -i "renderer string")
case "$RENDERER" in
  *llvmpipe*|*softpipe*|*SWR*|*SVGA3D*|*VMware*|*VirtualBox*|*virgl*|"") BACKEND=xrender ;;
  *) BACKEND=glx ;;
esac
[ -n "$SLOPE_PICOM_BACKEND" ] && BACKEND="$SLOPE_PICOM_BACKEND"
echo "$(date '+%F %T') renderer: ${RENDERER:-unknown} -> $BACKEND" >>"$LOG"

quick_fails=0
while xprop -root >/dev/null 2>&1; do
  CONF=/usr/share/slope/picom.conf
  [ -f "$HOME/.config/slope/picom.conf" ] && CONF="$HOME/.config/slope/picom.conf"
  start=$(date +%s)
  # (blur is ignored by the xrender backend; do not pass --blur-method none, it crashes picom 12)
  picom --config "$CONF" --backend "$BACKEND" >>"$LOG" 2>&1
  status=$?
  xprop -root >/dev/null 2>&1 || break           # the session is over
  if [ $status -eq 143 ]; then
    # stopped on purpose (SIGTERM: the Dock moved): start again right away
    echo "$(date '+%F %T') picom restarted with the new settings" >>"$LOG"
    continue
  fi
  if [ $(( $(date +%s) - start )) -lt 10 ]; then
    quick_fails=$((quick_fails + 1))
  else
    quick_fails=0
  fi
  echo "$(date '+%F %T') picom stopped (status $status), starting it again" >>"$LOG"
  if [ "$BACKEND" = glx ] && [ $quick_fails -ge 2 ]; then
    echo "$(date '+%F %T') glx keeps failing: using xrender" >>"$LOG"
    BACKEND=xrender
    quick_fails=0
  fi
  [ $quick_fails -ge 5 ] && sleep 10 || sleep 0.5
done
